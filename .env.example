# Environment (dev | prod)
VITE_ENVIRONMENT=dev

# CloudFront Configuration (Required)
VITE_CLOUDFRONT_URL=https://your-cloudfront-domain.cloudfront.net

# Contact form endpoint (Required for the contact page)
VITE_CONTACT_API_URL=https://your-api-id.execute-api.your-region.amazonaws.com/prod/contact

# Google Analytics (Optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# AWS targets for the dev-only admin live in admin.config.example.json,
# not here — nothing AWS-related belongs in the client bundle.
