# Environment (dev | prod)
VITE_ENVIRONMENT=dev

# CloudFront Configuration (Required)
VITE_CLOUDFRONT_URL=https://your-cloudfront-domain.cloudfront.net

# Google Analytics (Optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# AWS Configuration (for reference - actual config is in .NET appsettings.json)
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=your-image-bucket-name