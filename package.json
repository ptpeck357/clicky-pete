{
  "name": "clicky-pete",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint:eslint": "eslint . --max-warnings=10",
    "lint:eslint:fix": "eslint . --max-warnings=10 --fix",
    "lint:prettier": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "lint:prettier:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "fix": "npm run lint:eslint:fix && npm run lint:prettier:fix",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "preview": "vite preview",
    "verify:no-admin": "! grep -rqE 'AdminPage|__admin|adminService' dist",
    "ci": "npm run lint:eslint && npm run lint:prettier && npm run build && npm run verify:no-admin"
  },
  "dependencies": {
    "framer-motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-ga4": "^3.0.1",
    "react-masonry-css": "^1.0.16",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudfront": "^3.1111.0",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "exif-reader": "^2.0.3",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  }
}
